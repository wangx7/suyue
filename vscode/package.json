{
  "name": "suyue",
  "displayName": "素阅 · 文档阅读器",
  "description": "在 VS Code 里安静地阅读 Word、Excel、PPT、EPUB 电子书、CSV 和 Markdown，播放 flac 音频。本地解析，支持深色。",
  "version": "0.1.0",
  "publisher": "wangx123",
  "author": "wangx7",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangx7/suyue"
  },
  "homepage": "https://wangx7.github.io/suyue/",
  "bugs": "https://github.com/wangx7/suyue/issues",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "docx",
    "word",
    "excel",
    "xlsx",
    "csv",
    "markdown",
    "pptx",
    "powerpoint",
    "epub",
    "ebook",
    "flac",
    "viewer",
    "reader"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "suyue.word",
        "displayName": "素阅",
        "priority": "default",
        "selector": [
          { "filenamePattern": "*.docx" },
          { "filenamePattern": "*.docm" },
          { "filenamePattern": "*.dotx" },
          { "filenamePattern": "*.doc" },
          { "filenamePattern": "*.dot" }
        ]
      },
      {
        "viewType": "suyue.sheet",
        "displayName": "素阅",
        "priority": "default",
        "selector": [
          { "filenamePattern": "*.xlsx" },
          { "filenamePattern": "*.xlsm" },
          { "filenamePattern": "*.xlsb" },
          { "filenamePattern": "*.xls" },
          { "filenamePattern": "*.ods" }
        ]
      },
      {
        "viewType": "suyue.slides",
        "displayName": "素阅",
        "priority": "default",
        "selector": [
          { "filenamePattern": "*.pptx" },
          { "filenamePattern": "*.pptm" },
          { "filenamePattern": "*.ppsx" },
          { "filenamePattern": "*.ppsm" },
          { "filenamePattern": "*.potx" }
        ]
      },
      {
        "viewType": "suyue.epub",
        "displayName": "素阅",
        "priority": "default",
        "selector": [
          { "filenamePattern": "*.epub" }
        ]
      },
      {
        "viewType": "suyue.audio",
        "displayName": "素阅",
        "priority": "default",
        "selector": [
          { "filenamePattern": "*.flac" }
        ]
      },
      {
        "viewType": "suyue.audioOption",
        "displayName": "素阅",
        "priority": "option",
        "selector": [
          { "filenamePattern": "*.mp3" },
          { "filenamePattern": "*.wav" },
          { "filenamePattern": "*.ogg" },
          { "filenamePattern": "*.oga" }
        ]
      },
      {
        "viewType": "suyue.markdown",
        "displayName": "素阅",
        "priority": "option",
        "selector": [
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" },
          { "filenamePattern": "*.mdown" },
          { "filenamePattern": "*.mkd" },
          { "filenamePattern": "*.mdx" }
        ]
      },
      {
        "viewType": "suyue.csv",
        "displayName": "素阅",
        "priority": "option",
        "selector": [
          { "filenamePattern": "*.csv" },
          { "filenamePattern": "*.tsv" }
        ]
      }
    ],
    "commands": [
      {
        "command": "suyue.open",
        "title": "用素阅打开",
        "category": "素阅",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "suyue.open",
          "when": "resourceExtname =~ /^\\.(md|markdown|mdown|mkd|mdx|csv|tsv|mp3|wav|ogg|oga)$/i",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "suyue.open",
          "when": "resourceExtname =~ /^\\.(md|markdown|mdown|mkd|mdx|csv|tsv)$/i && activeEditor == workbench.editors.files.textFileEditor || resourceExtname =~ /^\\.(mp3|wav|ogg|oga)$/i && activeCustomEditorId == vscode.audioPreview",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "suyue.open",
          "when": "resourceExtname =~ /^\\.(md|markdown|mdown|mkd|mdx|csv|tsv|mp3|wav|ogg|oga)$/i"
        }
      ]
    }
  }
}
