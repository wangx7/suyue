{
  "manifest_version": 3,
  "name": "素阅 · 文档阅读器",
  "short_name": "素阅",
  "version": "0.1.0",
  "description": "安静地阅读 Word、Excel、CSV 和 Markdown。本地解析，不上传，支持深色。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开素阅",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
